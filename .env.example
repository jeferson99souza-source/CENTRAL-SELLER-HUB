# =============================================================================
# CENTRAL SELLER HUB — .env.example
# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA commite o arquivo .env com valores reais no repositório.
# =============================================================================

# =============================================================================
# APLICAÇÃO
# =============================================================================
NODE_ENV=development                         # development | staging | production
PORT=3000                                    # porta do servidor NestJS
APP_URL=http://localhost:3000                # URL base da API
FRONTEND_URL=http://localhost:3001           # URL do frontend (Next.js)
API_PREFIX=api/v1                            # prefixo global dos endpoints

# Chave de criptografia AES-256 para tokens OAuth (32 bytes em hex)
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=sua_chave_de_32_bytes_em_hex_aqui

# =============================================================================
# JWT — Autenticação de usuários do sistema
# =============================================================================
JWT_SECRET=seu_segredo_jwt_super_seguro_aqui
JWT_EXPIRES_IN=7d                            # tempo de expiração do token
JWT_REFRESH_SECRET=seu_segredo_refresh_aqui
JWT_REFRESH_EXPIRES_IN=30d

# =============================================================================
# BANCO DE DADOS — PostgreSQL
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=central_seller
DB_USER=postgres
DB_PASSWORD=sua_senha_postgres_aqui
DB_SSL=false                                 # true em produção
DB_POOL_SIZE=10                              # tamanho do pool de conexões

# URL completa (alternativa às variáveis acima)
# DATABASE_URL=postgresql://postgres:senha@localhost:5432/central_seller

# Réplica de leitura (para queries de dashboard)
DB_REPLICA_HOST=localhost
DB_REPLICA_PORT=5432

# =============================================================================
# REDIS — Cache e sessões
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=                              # deixe vazio se não tiver senha
REDIS_DB=0                                  # número do banco Redis
REDIS_TTL_DEFAULT=60                        # TTL padrão em segundos
REDIS_TTL_DASHBOARD=60                      # TTL das métricas do dashboard

# URL completa (alternativa)
# REDIS_URL=redis://:senha@localhost:6379/0

# =============================================================================
# RABBITMQ — Filas de mensagens
# =============================================================================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_PREFETCH=10                        # quantidade de msgs processadas por vez
RABBITMQ_MANAGEMENT_PORT=15672             # porta da UI de gerenciamento

# URL completa (alternativa)
# RABBITMQ_URL=amqp://guest:guest@localhost:5672

# =============================================================================
# MERCADO LIVRE
# Docs: https://developers.mercadolivre.com.br
# =============================================================================

# App credentials — obtenha em: https://developers.mercadolivre.com.br/devcenter
ML_APP_ID=seu_app_id_mercadolivre
ML_CLIENT_SECRET=seu_client_secret_mercadolivre

# URLs de OAuth
ML_AUTH_URL=https://auth.mercadolivre.com.br/authorization
ML_TOKEN_URL=https://api.mercadolibre.com/oauth/token
ML_REDIRECT_URI=http://localhost:3000/api/v1/integration/mercadolivre/callback

# URL base da API
ML_API_BASE_URL=https://api.mercadolibre.com

# Configurações de sincronização
ML_SYNC_INTERVAL_MINUTES=5                  # intervalo de sync em minutos
ML_WEBHOOK_SECRET=seu_webhook_secret_ml     # para validar webhooks do ML

# Notificações (webhooks)
# Configure em: https://developers.mercadolivre.com.br/pt_br/receba-notificacoes
ML_WEBHOOK_URL=https://seudominio.com/api/v1/webhooks/mercadolivre

# =============================================================================
# SHOPEE
# Docs: https://open.shopee.com/documents
# =============================================================================

# App credentials — obtenha em: https://open.shopee.com/
SHOPEE_PARTNER_ID=seu_partner_id_shopee
SHOPEE_PARTNER_KEY=seu_partner_key_shopee
SHOPEE_APP_ID=seu_app_id_shopee

# URLs de OAuth
SHOPEE_AUTH_URL=https://partner.shopeemobile.com/api/v2/shop/auth_partner
SHOPEE_TOKEN_URL=https://partner.shopeemobile.com/api/v2/auth/token/get
SHOPEE_REFRESH_TOKEN_URL=https://partner.shopeemobile.com/api/v2/auth/access_token/get
SHOPEE_REDIRECT_URI=http://localhost:3000/api/v1/integration/shopee/callback

# URL base da API
SHOPEE_API_BASE_URL=https://partner.shopeemobile.com

# Configurações de sincronização
SHOPEE_SYNC_INTERVAL_MINUTES=5
SHOPEE_WEBHOOK_SECRET=seu_webhook_secret_shopee

# =============================================================================
# AMAZON SP-API (Selling Partner API)
# Docs: https://developer-docs.amazon.com/sp-api
# =============================================================================

# Login with Amazon (LWA) — para obter tokens OAuth
# Crie sua aplicação em: https://sellercentral.amazon.com/apps/manage
AMAZON_LWA_APP_ID=seu_lwa_app_id_amazon
AMAZON_LWA_CLIENT_SECRET=seu_lwa_client_secret_amazon
AMAZON_LWA_REFRESH_TOKEN=token_refresh_do_vendedor  # obtido via OAuth
AMAZON_LWA_TOKEN_URL=https://api.amazon.com/auth/o2/token
AMAZON_REDIRECT_URI=http://localhost:3000/api/v1/integration/amazon/callback

# AWS Credentials — para assinar requests com AWS Signature v4
# Crie um usuário IAM com permissão de execução SP-API
AWS_ACCESS_KEY_ID=sua_aws_access_key
AWS_SECRET_ACCESS_KEY=sua_aws_secret_key
AWS_REGION=us-east-1                        # região do endpoint SP-API

# Marketplace IDs (por país)
AMAZON_MARKETPLACE_ID_BR=A2Q3Y263D00KWC    # Brasil
AMAZON_MARKETPLACE_ID_US=ATVPDKIKX0DER     # Estados Unidos

# URL base da SP-API
AMAZON_SP_API_BASE_URL=https://sellingpartnerapi-na.amazon.com

# ARN da função IAM para acesso à SP-API (se usar AWS Role)
AMAZON_ROLE_ARN=arn:aws:iam::123456789:role/CentralSellerSPAPI

# Configurações de sincronização
AMAZON_SYNC_INTERVAL_MINUTES=10
AMAZON_WEBHOOK_SECRET=seu_webhook_secret_amazon

# =============================================================================
# INTELIGÊNCIA ARTIFICIAL — Classificação e auto-resposta
# =============================================================================

# OpenAI — para geração de respostas automáticas
OPENAI_API_KEY=sk-sua_chave_openai_aqui
OPENAI_MODEL=gpt-4o-mini                   # modelo a usar (custo x qualidade)
OPENAI_MAX_TOKENS=500
OPENAI_TEMPERATURE=0.3                     # 0 = preciso, 1 = criativo

# Alternativa: Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-sua_chave_anthropic_aqui
ANTHROPIC_MODEL=claude-haiku-4-5-20251001  # modelo mais econômico para classificação

# Configurações de automação
AI_AUTO_REPLY_ENABLED=false                # habilitar respostas automáticas
AI_AUTO_REPLY_CONFIDENCE_THRESHOLD=0.85   # confiança mínima para responder sozinho

# =============================================================================
# EMAIL — Notificações e alertas internos
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false                          # true para porta 465
SMTP_USER=seu_email@gmail.com
SMTP_PASSWORD=sua_senha_de_app_gmail
SMTP_FROM=noreply@centralseller.com.br

# Alertas de SLA
SLA_ALERT_EMAIL=alertas@suaempresa.com.br
SLA_ALERT_ADVANCE_HOURS=4                  # avisar X horas antes do SLA vencer

# =============================================================================
# WEBSOCKET — Socket.io
# =============================================================================
WS_CORS_ORIGINS=http://localhost:3001      # origens permitidas (separadas por vírgula)
WS_PING_INTERVAL=25000                    # ms
WS_PING_TIMEOUT=5000                      # ms

# =============================================================================
# RATE LIMITING
# =============================================================================
THROTTLE_TTL=60000                         # janela de tempo em ms (60s)
THROTTLE_LIMIT=60                          # requisições por janela por IP/tenant

# Limites específicos por marketplace (req/hora)
ML_RATE_LIMIT_PER_HOUR=36000
SHOPEE_RATE_LIMIT_PER_HOUR=1000
AMAZON_RATE_LIMIT_PER_HOUR=3600

# =============================================================================
# ARMAZENAMENTO — Uploads e arquivos
# =============================================================================
# AWS S3 — para armazenar anexos de conversas e relatórios
S3_ACCESS_KEY_ID=sua_aws_s3_access_key
S3_SECRET_ACCESS_KEY=sua_aws_s3_secret_key
S3_BUCKET_NAME=central-seller-uploads
S3_REGION=us-east-1
S3_BASE_URL=https://central-seller-uploads.s3.amazonaws.com

# =============================================================================
# MONITORAMENTO — Logs e métricas
# =============================================================================
# Sentry — rastreamento de erros
SENTRY_DSN=https://sua_chave@sentry.io/projeto

# Log level
LOG_LEVEL=debug                            # debug | info | warn | error

# Prometheus (métricas)
METRICS_ENABLED=true
METRICS_PATH=/metrics
METRICS_PORT=9090

# =============================================================================
# SEGURANÇA
# =============================================================================
# CORS — origens permitidas na API
CORS_ORIGINS=http://localhost:3001         # separar por vírgula em produção

# Helmet — headers de segurança
HELMET_ENABLED=true

# Sessões
SESSION_SECRET=seu_segredo_de_sessao_aqui

# =============================================================================
# MULTI-TENANT
# =============================================================================
# Header usado para identificar o tenant em cada request
TENANT_HEADER=x-tenant-id

# Tenant padrão para desenvolvimento local
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001

# =============================================================================
# FRONTEND (Next.js) — copie para frontend/.env.local
# =============================================================================
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Central Seller HUB
NEXT_PUBLIC_APP_VERSION=1.0.0

# =============================================================================
# DESENVOLVIMENTO LOCAL
# =============================================================================
# Desabilitar verificações em dev
DEV_SKIP_AUTH=false                        # NUNCA true em produção
DEV_MOCK_MARKETPLACES=false               # usar respostas mockadas das APIs

# Seed de dados para desenvolvimento
SEED_ENABLED=true
SEED_TENANT_ID=00000000-0000-0000-0000-000000000001
